{
  "name": "architecture",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/architecture/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:util"],
  "implicitDependencies": ["*"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/lint/**",
        "{workspaceRoot}/{apps,libs}/**/eslint.config.mjs",
        "{workspaceRoot}/{apps,libs}/**/project.json",
        "{workspaceRoot}/apps/*/src/environments/*.ts",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/nx.json"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p {projectRoot}/tsconfig.spec.json"],
        "parallel": false
      }
    }
  }
}
