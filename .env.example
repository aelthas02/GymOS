# Copiado para .env pelo `pnpm dev` quando não existir. Valores para o docker-compose de dev.
# A API valida estas variáveis na inicialização (apps/api/src/config/env.ts) e não sobe se faltar alguma.

NODE_ENV=development
# Ambiente de implantação: development, staging ou production. Staging roda com NODE_ENV=production;
# o Sentry e os logs usam este nome.
APP_ENV=development
# Não use PORT: o Nx carrega este arquivo em todas as tarefas e o dev server do Angular leria a variável.
API_PORT=3000
# Proxies confiáveis na frente da API (ingress/CDN). 0 em dev; em staging e prod costuma ser 1.
TRUST_PROXY_HOPS=0

# Logs JSON (pino): fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# Sentry da API. Vazio desliga o envio. O release costuma ser a tag ou o commit, definido pelo deploy.
SENTRY_DSN=
SENTRY_RELEASE=

# Postgres 16 (serviço postgres). A API conecta como gymos_app (sem BYPASSRLS); as migrações rodam
# como gymos_migrator, dono das tabelas. `pnpm gymos preparar-banco` cria os dois papéis com a conta
# de administrador (CREATEDB e CREATEROLE) e `pnpm nx run api:migrar` aplica as migrações (ADR-003).
DATABASE_URL=postgresql://gymos_app:gymos_app@localhost:5432/gymos
DATABASE_MIGRATOR_URL=postgresql://gymos_migrator:gymos_migrator@localhost:5432/gymos
DATABASE_ADMIN_URL=postgresql://gymos:gymos@localhost:5432/postgres
# Testes de integração: cada execução cria bancos gymos_test_* com esta conta e os apaga no fim.
TEST_DATABASE_ADMIN_URL=postgresql://gymos:gymos@localhost:5432/postgres

# Tenant por subdomínio (ADR-004): ritmo.localhost em dev. Fora de produção, o cabeçalho x-tenant
# também escolhe o tenant e x-relogio fixa o relógio da requisição.
TENANT_BASE_DOMAIN=localhost
# Endereço do painel de cada academia, usado no link do convite; {tenant} vira o slug.
STAFF_WEB_URL=http://{tenant}.localhost:4200
# Chave do endpoint interno de operação (criar academia). Sem ela, o endpoint responde 404.
OPERACAO_API_KEY=gymos-dev-chave-de-operacao-troque-fora-do-dev

# Autenticação (T12): segredo HS256 do token de acesso, 32 caracteres ou mais. Troque fora do dev.
AUTH_JWT_SECRET=gymos-dev-segredo-do-jwt-troque-fora-do-dev
# Endereço do app do aluno de cada academia, usado nos links de e-mail; {tenant} vira o slug.
STUDENT_APP_URL=http://{tenant}.localhost:4300
# Chave mestra local da cifra de campos (T13c): 32 bytes em base64. Só dev, teste e staging; produção
# usa o KMS. Troque fora do dev: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
CHAVE_MESTRA_LOCAL=Z3ltb3MtZGV2LWNoYXZlLW1lc3RyYS0zMi1ieXRlcyE=

# Redis 7 (serviço redis)
REDIS_URL=redis://localhost:6379
# Prefixo de filas, cache e canais no Redis (T13a).
REDIS_PREFIXO=gymos
# true sobe os workers das filas e o despachante do outbox neste processo da API.
FILAS_PROCESSAR=true

# Mailpit (serviço mailpit): SMTP em 1025, caixa de entrada em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# smtp envia pelo SMTP_HOST; fake só guarda em memória (máquina sem Mailpit).
EMAIL_TRANSPORTE=smtp
EMAIL_REMETENTE=GymOS <nao-responda@gymos.app>

# Pagamentos (T19, ADR-009): só o provedor fake até a escolha do real. O segredo assina os webhooks
# (HMAC-SHA256 no cabeçalho x-assinatura); a URL pública monta o link das páginas de pagamento simuladas.
PAGAMENTOS_PROVEDOR=fake
PAGAMENTOS_WEBHOOK_SEGREDO=gymos-dev-segredo-dos-webhooks
PAGAMENTOS_URL_PUBLICA=http://localhost:3000
# Web Push (T13e): vapid envia pelos provedores dos navegadores; fake só guarda em memória (não vale em
# produção). Para testar push real, use PUSH_TRANSPORTE=vapid com um par gerado na sua máquina:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# Nunca commite a chave privada (nem a de dev).
PUSH_TRANSPORTE=fake
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@gymos.app

# Integrações de plataforma (T13d): só adapters fake por ora. O segredo assina os webhooks de mensagem
# (HMAC-SHA256 no cabeçalho x-hub-signature-256). ARMAZENAMENTO=fake guarda os arquivos em memória; s3
# usa o MinIO abaixo (ARMAZENAMENTO_URL_PUBLICA é o endereço da API nas URLs assinadas do fake).
META_PROVEDOR=fake
MENSAGERIA_TRANSPORTE=fake
MENSAGERIA_WEBHOOK_SEGREDO=gymos-dev-segredo-da-mensageria
IA_PROVEDOR=fake
ARMAZENAMENTO=fake
ARMAZENAMENTO_URL_PUBLICA=http://localhost:3000

# MinIO, armazenamento compatível com S3 (serviço minio): console em http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gymos
S3_ACCESS_KEY_ID=gymos
S3_SECRET_ACCESS_KEY=gymos-dev-secret
