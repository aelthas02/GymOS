# Copiado para .env pelo `pnpm dev` quando não existir. Valores para o docker-compose de dev.
# A API valida estas variáveis na inicialização (apps/api/src/config/env.ts) e não sobe se faltar alguma.

NODE_ENV=development
PORT=3000

# Postgres 16 (serviço postgres)
DATABASE_URL=postgresql://gymos:gymos@localhost:5432/gymos

# Redis 7 (serviço redis)
REDIS_URL=redis://localhost:6379

# Mailpit (serviço mailpit): SMTP em 1025, caixa de entrada em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# MinIO, armazenamento compatível com S3 (serviço minio): console em http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gymos
S3_ACCESS_KEY_ID=gymos
S3_SECRET_ACCESS_KEY=gymos-dev-secret
