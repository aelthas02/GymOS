          "autenticacao"
        ]
      }
    },
    "/api/auth/aluno/primeiro-acesso": {
      "post": {
        "operationId": "primeiroAcessoNoApp",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrimeiroAcessoDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Identificador ou código inválido ou expirado."
          },
          "429": {
            "description": "Muitas tentativas erradas. Tente de novo em alguns minutos."
          }
        },
        "summary": "Cria a senha com o código entregue pela recepção e já entra no app.",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/auth/aluno/redefinir-senha": {
      "post": {
        "operationId": "redefinirSenhaDoApp",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedefinirSenhaDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "410": {
            "description": "Link expirado ou já usado."
          }
        },
        "summary": "Nova senha pelo link.",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/auth/aluno/refresh": {
      "post": {
        "operationId": "renovarSessaoDoApp",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Sessão encerrada. Entre de novo."
          },
          "403": {
            "description": "Sem o cabeçalho x-gymos-csrf ou de outra origem."
          }
        },
        "summary": "Troca o refresh do cookie por um novo par (rotativo; reuso revoga a família).",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/auth/staff/convites/aceitar": {
      "post": {
        "operationId": "aceitarConvite",
        "parameters": [],
