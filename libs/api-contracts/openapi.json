            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Envia o link de redefinição ao e-mail da conta, se houver (a resposta é sempre 204).",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/auth/aluno/login": {
      "post": {
        "operationId": "entrarNoApp",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntrarNoAppDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            },
            "description": "Grava o cookie gymos_rt_aluno."
          },
          "401": {
            "description": "E-mail, CPF ou senha incorretos."
          },
          "429": {
            "description": "Muitas tentativas erradas. Tente de novo em alguns minutos."
          }
        },
        "summary": "Login do aluno (CPF ou e-mail e senha).",
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/auth/aluno/logout": {
      "post": {
        "operationId": "sairDoApp",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
