    "/api/equipe/convites": {
      "post": {
        "operationId": "convidarParaEquipe",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConvidarDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConviteCriadoDto"
                }
              }
            },
            "description": ""
          },
