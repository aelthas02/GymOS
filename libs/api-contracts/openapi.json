{
  "components": {
    "schemas": {
      "AceitarConviteDto": {
        "properties": {
          "nome": {
            "example": "Diego Martins",
            "maxLength": 120,
            "type": "string"
          },
          "senha": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "nome",
          "senha"
        ],
        "type": "object"
      },
      "AtividadeDto": {
        "properties": {
          "acao": {
            "example": "alterou-valor",
            "type": "string"
          },
          "acaoTexto": {
            "example": "Alterou valor",
            "type": "string"
          },
          "detalhe": {
            "example": "Plano Mensal: R$ 109,00 para R$ 119,00",
            "type": "string"
          },
          "etiqueta": {
            "example": "Sensível",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "modulo": {
            "example": "planos",
            "type": "string"
          },
          "moduloTexto": {
            "example": "Planos",
            "type": "string"
          },
          "papel": {
            "example": "Gerente",
            "type": "string"
          },
          "quando": {
            "format": "date-time",
            "type": "string"
          },
          "quem": {
            "example": "Carla Menezes",
            "type": "string"
          },
          "quemId": {
            "description": "Nulo: o sistema.",
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "sensivel": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "quando",
          "quem",
          "quemId",
          "papel",
          "acao",
          "acaoTexto",
          "modulo",
          "moduloTexto",
          "detalhe",
          "sensivel",
          "etiqueta"
        ],
        "type": "object"
      },
      "ConvidarDto": {
        "properties": {
          "email": {
            "example": "diego@ritmo.com.br",
            "type": "string"
          },
          "nome": {
            "example": "Diego Martins",
            "maxLength": 120,
            "nullable": true,
            "type": "string"
          },
          "tipoDeAcessoId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "email",
          "nome",
          "tipoDeAcessoId"
        ],
        "type": "object"
      },
      "ConviteCriadoDto": {
        "properties": {
          "expiraEm": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "expiraEm"
        ],
        "type": "object"
      },
      "EntrarNoAppDto": {
        "properties": {
          "identificador": {
            "description": "CPF (com ou sem pontuação) ou e-mail.",
            "example": "123.456.789-09",
            "type": "string"
          },
          "senha": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "identificador",
          "senha"
        ],
        "type": "object"
      },
      "EntrarNoPainelDto": {
        "properties": {
          "email": {
            "example": "carla@ritmo.com.br",
            "maxLength": 254,
            "type": "string"
          },
          "senha": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "email",
          "senha"
        ],
        "type": "object"
      },
      "EsqueciSenhaDoAppDto": {
        "properties": {
          "identificador": {
            "description": "CPF (com ou sem pontuação) ou e-mail.",
            "type": "string"
          }
        },
        "required": [
          "identificador"
        ],
        "type": "object"
      },
      "EsqueciSenhaDoPainelDto": {
        "properties": {
          "email": {
            "example": "carla@ritmo.com.br",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "IdentidadeDoTenantDto": {
        "properties": {
          "corDestaque": {
            "example": "#22C98A",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          "logotipoUrl": {
            "example": null,
            "format": "uri",
            "maxLength": 2048,
            "nullable": true,
            "type": "string"
          },
          "nome": {
            "example": "Academia Ritmo",
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": [
          "nome",
          "corDestaque",
          "logotipoUrl"
        ],
        "type": "object"
      },
      "ModuloExtra": {
        "enum": [
          "aulas",
          "marketing",
          "loja",
          "saude"
        ],
        "type": "string"
      },
      "PaginaDoLogDto": {
        "properties": {
          "itens": {
            "items": {
              "$ref": "#/components/schemas/AtividadeDto"
            },
            "type": "array"
          },
          "proximoCursor": {
            "description": "Nulo na última página.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "itens",
          "proximoCursor"
        ],
        "type": "object"
      },
      "PerfilDto": {
        "properties": {
          "email": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "description": "Usuário da equipe ou aluno.",
            "format": "uuid",
            "type": "string"
          },
          "modulos": {
            "items": {
              "$ref": "#/components/schemas/ModuloExtra"
            },
            "type": "array"
          },
          "nome": {
            "nullable": true,
            "type": "string"
          },
          "permissoes": {
            "description": "Permissões `modulo:acao` (ações: ver, criar, editar, excluir).",
            "example": [
              "alunos:ver",
              "alunos:criar"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tipo": {
            "enum": [
              "staff",
              "aluno"
            ],
            "type": "string"
          },
          "tipoDeAcesso": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoDeAcessoResumoDto"
              }
            ],
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "tipo",
          "id",
          "nome",
          "email",
          "tipoDeAcesso",
          "permissoes",
          "modulos"
        ],
        "type": "object"
      },
      "PrimeiroAcessoDto": {
        "properties": {
          "codigo": {
            "description": "Código entregue pela recepção.",
            "example": "K7M2QX9P",
            "type": "string"
          },
          "identificador": {
            "description": "CPF (com ou sem pontuação) ou e-mail.",
            "example": "123.456.789-09",
            "type": "string"
          },
          "senha": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "identificador",
          "codigo",
          "senha"
        ],
        "type": "object"
      },
      "RedefinirSenhaDto": {
        "properties": {
          "senha": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "senha"
        ],
        "type": "object"
      },
      "SessaoDto": {
        "properties": {
          "accessToken": {
            "description": "JWT de acesso, válido por 10 minutos (Authorization: Bearer).",
            "type": "string"
          },
          "expiraEm": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "expiraEm"
        ],
        "type": "object"
      },
      "TipoDeAcessoResumoDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "nome": {
            "example": "Gerente",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nome"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Contrato único da API do GymOS, gerado pelo @nestjs/swagger (ADR-005).",
    "title": "GymOS API",
    "version": "1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/auditoria/atividades": {
      "get": {
        "operationId": "listarAtividades",
        "parameters": [
          {
            "description": "Usuário que agiu.",
            "in": "query",
            "name": "usuarioId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Chave do módulo (catálogo de módulos).",
            "in": "query",
            "name": "modulo",
            "required": false,
            "schema": {
              "example": "planos",
              "type": "string"
            }
          },
          {
            "description": "Início do período, inclusive.",
            "in": "query",
            "name": "de",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Fim do período, exclusivo.",
            "in": "query",
            "name": "ate",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "`todos`: cronológico; `destaque` (\"Todos, com sensíveis em destaque\"): sensíveis primeiro; `sensiveis`: só os sensíveis.",
            "in": "query",
            "name": "tipo",
            "required": false,
            "schema": {
              "default": "todos",
              "enum": [
                "todos",
                "destaque",
                "sensiveis"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limite",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "`proximoCursor` da página anterior.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaDoLogDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Filtro ou cursor inválido."
          },
          "401": {
            "description": "Sem sessão válida."
          },
          "403": {
            "description": "Exige a permissão permissoes:ver."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Log de atividades paginado por cursor, com os filtros de Log.html.",
        "tags": [
          "auditoria"
        ]
      }
    },
    "/api/auditoria/atividades/exportar": {
      "get": {
        "operationId": "exportarAtividades",
        "parameters": [
          {
            "description": "Usuário que agiu.",
            "in": "query",
            "name": "usuarioId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Chave do módulo (catálogo de módulos).",
            "in": "query",
            "name": "modulo",
            "required": false,
            "schema": {
              "example": "planos",
              "type": "string"
            }
          },
          {
            "description": "Início do período, inclusive.",
            "in": "query",
            "name": "de",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Fim do período, exclusivo.",
            "in": "query",
            "name": "ate",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "`todos`: cronológico; `destaque` (\"Todos, com sensíveis em destaque\"): sensíveis primeiro; `sensiveis`: só os sensíveis.",
            "in": "query",
            "name": "tipo",
            "required": false,
            "schema": {
              "default": "todos",
              "enum": [
                "todos",
                "destaque",
                "sensiveis"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Arquivo CSV (UTF-8 com BOM, separador `;`)."
          },
          "400": {
            "description": "Filtro inválido."
          },
          "401": {
            "description": "Sem sessão válida."
          },
          "403": {
            "description": "Exige a permissão permissoes:ver."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "CSV do log com os mesmos filtros (Quando, Quem, Ação, Módulo, Sensível, Detalhe).",
        "tags": [
          "auditoria"
        ]
      }
    },
    "/api/auth/aluno/esqueci-senha": {
      "post": {
        "operationId": "esqueciSenhaDoApp",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EsqueciSenhaDoAppDto"
