                "$ref": "#/components/schemas/AceitarConviteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            },
            "description": ""
          },
          "404": {
            "description": "Convite inexistente."
          },
          "409": {
            "description": "Já existe usuário com este e-mail."
          },
          "410": {
            "description": "Convite expirado ou já usado."
          }
        },
        "summary": "Cria a senha pelo link do convite e já entra no painel.",
        "tags": [
          "autenticacao"
        ]
      }
    },
