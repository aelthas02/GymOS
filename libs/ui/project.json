{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "prefix": "ui",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p {projectRoot}/tsconfig.lib.json",
          "tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      },
      "options": {
        "port": 4400,
        "configDir": "libs/ui/.storybook",
        "browserTarget": "ui:build-storybook",
        "compodoc": false,
        "styles": ["libs/ui/styles/index.css"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/styles"]
        },
        "experimentalZoneless": true
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ui",
        "configDir": "libs/ui/.storybook",
        "browserTarget": "ui:build-storybook",
        "compodoc": false,
        "styles": ["libs/ui/styles/index.css"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/styles"]
        },
        "experimentalZoneless": true
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
