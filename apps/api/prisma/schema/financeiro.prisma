// Modelos do domínio financeiro (T21, ADR-020): lançamentos de despesas e receitas avulsas. A folha não
// é lançamento: vem do custo mensal do Funcionário (T26a). Tabela criada por `nx g @gymos/api:tabela`;
// campos na migração `campos_do_financeiro`. O rateio da receita é calculado na consulta, não guardado.

/// Despesa ou receita avulsa. `tipo`: despesa ou receita. `categoria`: aluguel, contas ou outros.
/// `setor` nulo é despesa geral, não alocada a um setor.
model Lancamento {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  tipo          String
  categoria     String
  setor         String?
  valorCentavos Int      @map("valor_centavos")
  data          DateTime @db.Date
  unidadeId     String   @map("unidade_id") @db.Uuid
  descricao     String?
  criadoPor     String?  @map("criado_por") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, data])
  @@map("lancamento")
}
