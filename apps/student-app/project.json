{
  "name": "student-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/student-app/src",
  "tags": ["scope:student", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/student-app",
        "browser": "apps/student-app/src/main.ts",
        "tsConfig": "apps/student-app/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/student-app/public"
          },
          {
            "glob": "*.woff2",
            "input": "libs/ui/styles/fonts/inter",
            "output": "fonts/inter"
          }
        ],
        "styles": ["libs/ui/styles/index.css", "apps/student-app/src/styles.css"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/styles"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "750kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/student-app/src/environments/environment.ts",
              "with": "apps/student-app/src/environments/environment.prod.ts"
            }
          ]
        },
        "staging": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "750kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/student-app/src/environments/environment.ts",
              "with": "apps/student-app/src/environments/environment.staging.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/student-app/src/environments/environment.ts",
              "with": "apps/student-app/src/environments/environment.dev.ts"
            }
          ]
        },
        "verificacao-budget": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1kb",
              "maximumError": "2kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/student-app/src/environments/environment.ts",
              "with": "apps/student-app/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": ["api:serve"],
      "options": {
        "port": 4300,
        "proxyConfig": "apps/student-app/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "student-app:build:production"
        },
        "staging": {
          "buildTarget": "student-app:build:staging"
        },
        "development": {
          "buildTarget": "student-app:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/student-app"],
      "options": {
        "watch": false,
        "coverage": true,
        "coverageReporters": ["text-summary", "lcov"],
        "coverageInclude": ["apps/student-app/src/**/*.ts"],
        "coverageExclude": ["apps/student-app/src/main.ts", "apps/student-app/src/environments/**"]
      },
      "configurations": {
        "cobertura": {
          "coverageThresholds": {
            "lines": 85,
            "branches": 80
          }
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "student-app:build",
        "port": 4300,
        "staticFilePath": "dist/apps/student-app/browser",
        "spa": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p {projectRoot}/tsconfig.spec.json"],
        "parallel": false
      }
    }
  }
}
